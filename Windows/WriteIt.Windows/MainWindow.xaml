<Window
    x:Class="WriteIt.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WriteIt.Windows"
    Title="WriteIt">
    <Grid x:Name="Root" Padding="24" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Text="Write anywhere" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Handwrite a thought, then paste it into the app you were using." Opacity="0.7" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="16">
                <Button x:Name="StartCaptureButton" Click="StartCaptureButton_Click" HorizontalAlignment="Left" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Edit" />
                        <TextBlock Text="Start writing" />
                    </StackPanel>
                </Button>
                <InfoBar x:Name="StatusInfoBar" IsOpen="True" IsClosable="False" Severity="Informational" Title="Ready" Message="Configure a shortcut, then start writing." />
                <TextBlock Text="How it works" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="1. Press your shortcut to open the writing surface.&#x0a;2. Write with a mouse or pen.&#x0a;3. Submit to recognize, copy, and request a paste." TextWrapping="Wrap" Opacity="0.8" />
                <TextBlock Text="Recent history" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
                <ListView ItemsSource="{Binding HistoryEntries}" MaxHeight="220">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:HistoryRow">
                            <StackPanel Padding="0,6">
                                <TextBlock Text="{x:Bind Text}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Detail}" FontSize="12" Opacity="0.6" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="12">
                <TextBlock Text="Settings" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="Global shortcut" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="ShortcutText" FontFamily="Consolas" Width="180" />
                    <Button Content="Apply" Click="ApplyShortcutButton_Click" />
                </StackPanel>
                <TextBlock Text="Recognition language" />
                <ComboBox x:Name="LanguagePicker" DisplayMemberPath="DisplayName" SelectionChanged="LanguagePicker_SelectionChanged" />
                <TextBlock Text="History" />
                <ComboBox x:Name="HistoryModePicker" SelectionChanged="HistoryModePicker_SelectionChanged">
                    <ComboBoxItem Tag="TextOnly" Content="Text history" />
                    <ComboBoxItem Tag="Full" Content="Text + ink history" />
                    <ComboBoxItem Tag="Off" Content="No history" />
                </ComboBox>
                <ToggleSwitch x:Name="AutoDeleteToggle" Header="Auto-delete history" Toggled="AutoDeleteToggle_Toggled" />
                <NumberBox x:Name="RetentionDaysBox" Header="Retention days" Minimum="1" Maximum="365" SpinButtonPlacementMode="Compact" ValueChanged="RetentionDaysBox_ValueChanged" />
                <NumberBox x:Name="StrokeWidthBox" Header="Ink width" Minimum="1" Maximum="12" SpinButtonPlacementMode="Compact" ValueChanged="StrokeWidthBox_ValueChanged" />
                <TextBlock Text="Text always remains on the clipboard after a paste request. Direct insertion into elevated or unsupported apps may be blocked." TextWrapping="Wrap" FontSize="12" Opacity="0.65" />
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="2" Text="Windows MVP · Local OCR · No cloud data sent" Opacity="0.55" FontSize="12" />
    </Grid>
</Window>
